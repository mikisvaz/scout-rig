scout-rig=/$PWD filter="*" {
 LICENSE.txt
 README.rdoc
 Rakefile
 chats=chats{

  biomodel_fix
 }
 lib=lib {
  scout-rig.rb
  scout=scout{
   python.rb
   python=python{
    paths.rb
    run.rb
    script.rb
    util.rb
   }
   workflow=workflow{
    python.rb
    python=python{
     inputs.rb
     task.rb
    }
   }
  }
 }
 test=test{
  test_helper.rb
  scout=scout{
   test_python.rb
   workflow=workflow{
    test_python.rb
    python=python{
     test_task.rb
    }
   }
  }
 }
 python=python filter="*.py"{
  test.py
  scout=scout{
   __init__.py
   runner.py
   workflow.py
   workflow=workflow{
    remote.py
   }
  }
 }
 doc=doc{
  Improvements.md
  StartHere.md
  developer=developer{
   Architecture.md
   DataConversionInternals.md
   DesignPrinciples.md
   PythonTaskRunnerInternals.md
   PythonWorkflowInternals.md
   ScoutPythonInternals.md
  }
  user=user{
   Cookbook.md
   DefiningPythonTasks.md
   DrivingWorkflowsFromPython.md
   IteratingPythonData.md
   PassingDataToPython.md
   PythonEnvironments.md
   RunningPythonFromRuby.md
   ScriptingPython.md
   TestingAndPackaging.md
  }
 }
}
